# Discord Developer Portal → приложение → Bot → Reset Token
DISCORD_BOT_TOKEN=
# BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Числовой ID. Для групп обычно отрицательный, например -1001234567890
TELEGRAM_CHAT_ID=
DISCORD_GUILD_ID=
# Обычные голосовые каналы одного сервера, ID через запятую
DISCORD_VOICE_CHANNEL_IDS=111111111111111111,222222222222222222

# Необязательно: свой образ, опубликованный GitHub Actions в GHCR.
# Владелец и имя репозитория — в нижнем регистре.
# BOT_IMAGE=ghcr.io/owner/discord-voice-notification-bot:latest
